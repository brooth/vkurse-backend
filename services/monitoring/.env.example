# Copy to .env for local development (in services/monitoring): cp .env.example .env
# Spring reads .env through `spring.config.import` (see application.yaml).

SPRING_PROFILES_ACTIVE=dev
PORT=8090
# `debug` logs every SQL statement.
# VKURSE_LOG_SQL=debug

# Database (the local Postgres, started with `docker compose -f compose.dev.yaml up -d` in backend/). Schema `monitoring`.
DATABASE_URL=jdbc:postgresql://127.0.0.1:54322/postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Application (required: startup fails if missing)
VKURSE_NODE_ID=vkurse-monitoring-local
# Platform's VKURSE_PUBLIC_URL: the issuer of the access tokens, and where its keys are published.
VKURSE_PLATFORM_URL=http://localhost:8080
VKURSE_MAIL_FROM=VKurse <no-reply@vkurse.ru>

# SMTP (defaults to the local Mailpit on 127.0.0.1:54325)
# MAIL_HOST=
# MAIL_PORT=

# Telegram bot that sends our notifications (token from BotFather). A placeholder works locally.
TELEGRAM_BOT_TOKEN=placeholder

# This service's own telemetry: off unless you run Kafka (compose.dev.yaml) and turn it on.
# VKURSE_TELEMETRY_ENABLED=true
# KAFKA_BOOTSTRAP_SERVERS=localhost:54392
