# Copy to .env for local development (in services/platform): cp .env.example .env
# Spring reads .env through `spring.config.import` (see application.yaml).

SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Database (the local Postgres, started with `docker compose -f compose.dev.yaml up -d` in backend/)
DATABASE_URL=jdbc:postgresql://127.0.0.1:54322/postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Application (required: startup fails if missing)
VKURSE_NODE_ID=vkurse-platform-local
VKURSE_PUBLIC_URL=http://localhost:8080
# The web app: links in emails (a school invitation) lead there.
VKURSE_WEB_URL=http://localhost:3000
VKURSE_MAIL_FROM=VKurse <no-reply@vkurse.ru>
VKURSE_WEB_ORIGINS=http://localhost:3000

# Auth (required).
# RSA key that signs our tokens (PKCS#8 PEM on one line, newlines as \n). Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk '{printf "%s\\n", $0}'
VKURSE_AUTH_PRIVATE_KEY=
# Any name for that key; change it when the key changes.
VKURSE_AUTH_KEY_ID=local-1
# HMAC key for OTP and exchange code hashes: at least 32 characters, e.g. `openssl rand -base64 48`.
VKURSE_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef

# Supabase Storage (from the same compose file; the key is Supabase's published local demo key).
# Behind the Supabase gateway both URLs end with /storage/v1.
VKURSE_STORAGE_URL=http://127.0.0.1:54321
VKURSE_STORAGE_PUBLIC_URL=http://127.0.0.1:54321
VKURSE_STORAGE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Payments. The key encrypts schools' payment credentials in the database: 32 random bytes in Base64, from
# `openssl rand -base64 32`. Losing or changing it loses every connected merchant.
VKURSE_PAYMENT_ENCRYPTION_KEY=

# SMTP (defaults to the local Mailpit on 127.0.0.1:54325)
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Telegram bot that sends our notifications (token from BotFather). A placeholder works locally.
TELEGRAM_BOT_TOKEN=placeholder

# Google sign-in (Google Cloud console → OAuth client, redirect URI {VKURSE_PUBLIC_URL}/auth/oauth/google/callback)
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# Sign in with Apple (Apple developer console: Services ID, team, key id, .p8 key content with \n for newlines).
# Apple only redirects to registered HTTPS URLs: test through a tunnel (cloudflared) set as VKURSE_PUBLIC_URL.
APPLE_CLIENT_ID=placeholder
APPLE_TEAM_ID=placeholder
APPLE_KEY_ID=placeholder
APPLE_PRIVATE_KEY=placeholder
